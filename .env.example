# =============================================================================
# PRIVATE SERVER SECRETS — never commit real values in this file's ".env" copy
# =============================================================================
# 1. Copy this file to ".env" next to docker-compose.yml (only on your machine).
# 2. Fill in real values below.
# 3. Start: docker compose up --build
#
# If SMTP_* is missing or still a placeholder:
#   - Registration still works (accounts are created without email verification)
#   - Password-reset emails are unavailable until you configure SMTP
# =============================================================================

ENTSOE_API_KEY=your_entsoe_api_key_here
JWT_SECRET=green-energy-monitor-dev-jwt-key-change-me-32chars!
# Server-only pepper for password hashing (HMAC-SHA256 before BCrypt). Never commit real values.
PASSWORD_PEPPER=green-energy-monitor-dev-password-pepper-change-me!
FRONTEND_BASE_URL=http://localhost:3000

# Comma-separated frontend URLs allowed to call the API (CORS).
# Local: http://localhost:5173,http://localhost:3000
# Production (Render static site): https://green-energy-monitor-frontend.onrender.com
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Optional SMTP (Gmail App Password recommended)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USE_SSL=true
SMTP_USERNAME=app.sender@gmail.com
SMTP_PASSWORD=xxxx xxxx xxxx xxxx
SMTP_FROM=app.sender@gmail.com
