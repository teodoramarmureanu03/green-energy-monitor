# Copy to ".env" next to docker-compose.yml, then:
#   docker compose up --build
#
# ENTSO-E key is required for live energy data.
# JWT_SECRET is used for login/register tokens (optional; a default is used if omitted).

ENTSOE_API_KEY=your_entsoe_api_key_here
JWT_SECRET=green-energy-monitor-dev-jwt-key-change-me-32chars!
