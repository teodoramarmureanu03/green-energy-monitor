# Copy to .env at the repo root for local docker-compose.

ENTSOE_API_KEY=
JWT_SECRET=green-energy-monitor-dev-jwt-key-change-me-32chars!
PASSWORD_PEPPER=green-energy-monitor-dev-password-pepper-change-me!

# Prefer Resend (works on Render Free — HTTPS, not SMTP).
# Create a key at https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxx
# Without a verified domain, use Resend's test sender:
SMTP_FROM=onboarding@resend.dev
FRONTEND_BASE_URL=http://localhost:3000

# Optional local SMTP (MailKit). Not needed if RESEND_API_KEY is set.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# SMTP_USE_SSL=true
# SMTP_USERNAME=
# SMTP_PASSWORD=

# Set true only to skip emails (dev / emergency). Leave false when using Resend.
EMAIL_BYPASS=false
