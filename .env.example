# Copy to ".env" next to docker-compose.yml, then:
#   docker compose up --build
#
# ENTSO-E key is required for live energy data.
# JWT_SECRET is used for login/register tokens (optional; a default is used if omitted).
#
# SMTP_* is the app's sender mailbox (fixed credentials to send mail).
# Recipients are dynamic: whatever email the user types on Forgot password.
# Prefer port 465 (works more reliably from Docker than 587).
#
# Gmail setup:
# 1. Enable 2-Step Verification
# 2. Create an App Password (Security → App passwords)
# 3. Put that mailbox + app password below

ENTSOE_API_KEY=your_entsoe_api_key_here
JWT_SECRET=green-energy-monitor-dev-jwt-key-change-me-32chars!

SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USE_SSL=true
SMTP_USERNAME=app.sender@gmail.com
SMTP_PASSWORD=xxxx xxxx xxxx xxxx
SMTP_FROM=app.sender@gmail.com
FRONTEND_BASE_URL=http://localhost:3000
