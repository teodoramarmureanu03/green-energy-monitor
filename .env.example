# Copy to ".env" for local Docker. Never commit real secrets.

# Required for ENTSO-E sync on the backend.
ENTSOE_API_KEY=your_entsoe_api_key_here

# JWT signing secret (use a long random string in production).
JWT_SECRET=change-me-to-a-long-random-secret-at-least-32-chars

# Comma-separated frontend URLs allowed to call the API (CORS).
# Local example:
# ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
# Production example (Netlify):
# ALLOWED_ORIGINS=https://your-site.netlify.app
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
