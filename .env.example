# =============================================================================
# PRIVATE SERVER SECRETS — never commit this file
# =============================================================================
# 1. Copy this file to ".env" next to docker-compose.yml (only on your machine
#    or the deployment host — Git ignores .env).
# 2. Fill in real values below.
# 3. Start: docker compose up --build
#
# Visitors of your public site never see this file. Only the backend container
# reads these variables on the host where Docker runs.
#
# If SMTP_* is missing or still a placeholder:
#   - Registration still works (accounts are created without email verification)
#   - Password-reset emails are unavailable until you configure SMTP
# =============================================================================

# Required for live energy data from ENTSO-E.
ENTSOE_API_KEY=your_entsoe_api_key_here

# Used for login/register tokens. Change this in any shared/public deployment.
JWT_SECRET=green-energy-monitor-dev-jwt-key-change-me-32chars!

# Public URL of the frontend (used in verification / reset email links).
# Local Docker: http://localhost:3000
# Deployed site: https://your-public-frontend-host
FRONTEND_BASE_URL=http://localhost:3000

# -----------------------------------------------------------------------------
# Optional SMTP (recommended for production email verification + password reset)
# Keep these ONLY in the host .env — never push them to GitHub.
#
# Gmail setup:
# 1. Enable 2-Step Verification
# 2. Create an App Password (Security → App passwords)
# Prefer port 465 (works more reliably from Docker than 587).
# -----------------------------------------------------------------------------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USE_SSL=true
SMTP_USERNAME=app.sender@gmail.com
SMTP_PASSWORD=xxxx xxxx xxxx xxxx
SMTP_FROM=app.sender@gmail.com
